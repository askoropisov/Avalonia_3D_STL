<UserControl
    x:Class="Avalonia_3D_STL.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Avalonia_3D_STL.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">



    <Grid ColumnDefinitions="*,2*">
        <views:MenuView Grid.Column="0" DataContext="{Binding Menu}"/>
        <views:STL_View Grid.Column="1" DataContext="{Binding STL}"/>
    </Grid>
</UserControl>
