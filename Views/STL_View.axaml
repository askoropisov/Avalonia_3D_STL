<UserControl
    x:Class="Avalonia_3D_STL.STL_View"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:openGL="using:Avalonia_3D_STL.Models._3D"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UniformGrid>
        <Grid Margin="4">
            <openGL:Renderer x:Name="glRenderer1" />

            <TextBlock Foreground="White" Text="Graphics Api Blender C#" Margin="10,10,0,0" />

            <Button Content="Button" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </UniformGrid>
</UserControl>
